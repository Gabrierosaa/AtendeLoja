FROM mcr.microsoft.com/dotnet/sdk:10.0.401 AS build
WORKDIR /src
COPY src/ src/
RUN dotnet restore src/Atende.Worker/Atende.Worker.csproj
RUN dotnet publish src/Atende.Worker/Atende.Worker.csproj -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/runtime:10.0.12 AS runtime
WORKDIR /app
COPY --from=build /app .
ENTRYPOINT ["dotnet", "Atende.Worker.dll"]
